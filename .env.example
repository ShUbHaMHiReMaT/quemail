# QuMail configuration -- copy to .env and fill in.
# .env is gitignored. NEVER commit real credentials.
# On Linux/macOS: chmod 600 .env

# ---------- Keystore (private keys, encrypted at rest) ----------
# Passphrase used to unlock the keystore. If unset, QuMail prompts on a TTY
# and refuses to start when running non-interactively (e.g. in a container).
QUMAIL_KEYSTORE_PASSPHRASE=
# Paths default to ~/.qumail/ -- override for containers/systemd.
# QUMAIL_KEYSTORE=/var/lib/qumail/keystore.json
# QUMAIL_CONTACTS=/var/lib/qumail/contacts.json
# QUMAIL_STATE_DIR=/var/lib/qumail/state
# QUMAIL_OUTPUT_DIR=/var/lib/qumail/inbox

# ---------- Outbound mail (SMTP) ----------
QUMAIL_SMTP_HOST=smtp.gmail.com
QUMAIL_SMTP_PORT=587
QUMAIL_SMTP_SECURITY=starttls
QUMAIL_SMTP_USERNAME=you@example.com
QUMAIL_SMTP_PASSWORD=
QUMAIL_FROM_ADDRESS=you@example.com

# ---------- Inbound mail (IMAP) ----------
QUMAIL_IMAP_HOST=imap.gmail.com
QUMAIL_IMAP_PORT=993
QUMAIL_IMAP_USERNAME=you@example.com
QUMAIL_IMAP_PASSWORD=
QUMAIL_IMAP_MAILBOX=INBOX

# ---------- Policy ----------
# Mail from a sender whose public identity is not in the contact store is
# never decrypted. Import senders with: qumail import-contact <file>
QUMAIL_POLL_INTERVAL=30
QUMAIL_MAX_MESSAGE_BYTES=1048576
QUMAIL_MAX_MESSAGE_AGE=604800
QUMAIL_MAX_CLOCK_SKEW=300

# ---------- Web inbox (qumail web) ----------
# Generate both values with:  qumail set-web-password
# The inbox shows decrypted mail and refuses to start without a password.
QUMAIL_WEB_PASSWORD_HASH=
QUMAIL_WEB_SESSION_SECRET=
# 127.0.0.1 keeps it on this machine. Use 0.0.0.0 only behind HTTPS.
QUMAIL_WEB_HOST=127.0.0.1
QUMAIL_WEB_PORT=8000
# Secure cookies require HTTPS; leave unset to follow the host automatically.
# QUMAIL_WEB_SECURE_COOKIES=true

# ---------- Logging ----------
QUMAIL_LOG_LEVEL=INFO
QUMAIL_LOG_FORMAT=text
